{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "firefly-feeds",
  "compatibility_date": "2026-09-11",
  "compatibility_flags": ["nodejs_compat"],
  "main": "vinext/server/app-router-entry",
  "assets": {
    "not_found_handling": "none",
  },
  "routes": [
    {
      "pattern": "feeds.fireflylabs.studio",
      "custom_domain": true,
    },
  ],
}
