{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "firefly-feeds",
  "compatibility_date": "2026-09-11",
  "compatibility_flags": ["nodejs_compat"],
  "main": "vinext/server/app-router-entry",
  "assets": {
    "not_found_handling": "none",
  },
  "ratelimits": [
    {
      "name": "FEED_FETCH",
      "namespace_id": "1001",
      "simple": {
        "limit": 40,
        "period": 60,
      },
    },
  ],
  "routes": [
    {
      "pattern": "feeds.fireflylabs.studio",
      "custom_domain": true,
    },
  ],
}
